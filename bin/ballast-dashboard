#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
launch_dir="$PWD"
if [[ -z "${IN_NIX_SHELL:-}" ]]; then
    exec nix develop "${repo_dir}#gcc" --command bash "$repo_dir/bin/ballast-dashboard" "$@"
fi
cd "$repo_dir"
work_dir="$repo_dir/build/ballast-dashboard"
viewer_args=()
comparison_archive=""
while (($#)); do
    if [[ "$1" == "--compare" ]]; then
        comparison_archive="$repo_dir/artifacts/ballast/stblob-move-experiment.zip"
        if (($# > 1)) && [[ "$2" != --* ]]; then
            comparison_archive="$2"
            [[ "$comparison_archive" == /* ]] || comparison_archive="$launch_dir/$comparison_archive"
            shift
        fi
    else
        viewer_args+=("$1")
    fi
    shift
done
if [[ -n "$comparison_archive" ]]; then
    for argument in "${viewer_args[@]}"; do
        if [[ "$argument" == "--data" ]]; then
            echo "Use either --compare or --data." >&2
            exit 1
        fi
    done
    python3 bin/ballast_dashboard_import.py "$comparison_archive" \
        --output "$work_dir/comparison.json" >&2
    viewer_args+=(--data "$work_dir/comparison.json")
fi
toolchain="$repo_dir/build/ballast-protocol/conan_toolchain.cmake"
if [[ ! -f "$toolchain" ]]; then
    conan install src/benchmarks/libxrpl/ballast --output-folder "$work_dir/dependencies" \
        --lockfile conan.lock --build missing --settings build_type=Release \
        --settings:build build_type=Release --conf tools.build:jobs=2 --conf:build tools.build:jobs=2 >&2
    toolchain="$work_dir/dependencies/conan_toolchain.cmake"
fi
cmake -S src/benchmarks/libxrpl/ballast/dashboard -B "$work_dir" \
    -DCMAKE_TOOLCHAIN_FILE="$toolchain" -DCMAKE_BUILD_TYPE=Release >&2
cmake --build "$work_dir" --target ballast_dashboard --parallel 2 >&2
exec "$work_dir/ballast_dashboard" "${viewer_args[@]}"
